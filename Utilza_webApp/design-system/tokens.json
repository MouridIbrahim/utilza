{
  "$schema": "utilza-design-tokens/v1",
  "description": "Single source of truth for the Utilza design system (web + Flutter). Generated artifacts: src/styles/tokens.css (web), Utilza_mobile/utilza/lib/design/app_tokens.dart (Flutter).",
  "brand": {
    "name": "Utilza",
    "tagline": "Everyday tools, all in one place.",
    "fontFamily": "Inter"
  },
  "colors": {
    "primary": "#6366F1",
    "primaryGradient": ["#818CF8", "#4F46E5"],
    "primaryPressedEdge": "#3730A3",
    "background": { "light": "#F6F7FB", "dark": "#0F1020" },
    "surface": { "light": "#FFFFFF", "dark": "#1A1B2E" },
    "surfaceElevated": { "light": "#FFFFFF", "dark": "#23253D" },
    "text": { "light": "#12122B", "dark": "#F2F3FF" },
    "textMuted": { "light": "#6B6F8A", "dark": "#A3A6C2" },
    "border": { "light": "#E4E7F0", "dark": "#2A2D49" },
    "success": "#10B981",
    "warning": "#F59E0B",
    "error": "#EF4444",
    "textSafeInk": {
      "_note": "Derived: pure spec hues fail AA as text on light surfaces, so text usages darken them. Fills, glows and gradients always use the spec hues above.",
      "success": { "light": "#047857", "dark": "#34D399" },
      "warning": { "light": "#B45309", "dark": "#FBBF24" },
      "error": { "light": "#DC2626", "dark": "#F87171" }
    }
  },
  "categories": {
    "calculators": { "label": "Calculators", "gradient": ["#818CF8", "#4F46E5"] },
    "date-time": { "label": "Date & Time", "gradient": ["#FBBF24", "#F59E0B"] },
    "text": { "label": "Text", "gradient": ["#34D399", "#059669"] },
    "generators": { "label": "Generators", "gradient": ["#F472B6", "#DB2777"] },
    "pdf": { "label": "PDF", "gradient": ["#F87171", "#DC2626"] },
    "image": { "label": "Image", "gradient": ["#38BDF8", "#0284C7"] },
    "documents": { "label": "Documents", "gradient": ["#A78BFA", "#7C3AED"] },
    "file": { "label": "File Tools", "gradient": ["#FB923C", "#EA580C"] },
    "url": { "label": "URL Tools", "gradient": ["#2DD4BF", "#0D9488"] }
  },
  "typography": {
    "display": { "size": 32, "weight": 700, "letterSpacing": -0.02 },
    "title": { "size": 20, "weight": 600, "letterSpacing": -0.01 },
    "body": { "size": 16, "weight": 400, "letterSpacing": 0 },
    "caption": { "size": 13, "weight": 500, "letterSpacing": 0 }
  },
  "shape": {
    "radius": { "card": 20, "tile": 16, "button": 14, "chip": 999 },
    "spacing": [4, 8, 12, 16, 24, 32]
  },
  "depth3d": {
    "cardInnerHighlight": { "light": "rgba(255,255,255,0.9)", "dark": "rgba(255,255,255,0.08)" },
    "cardTightShadow": "0 1px 2px rgba(0,0,0,0.08)",
    "cardGlow": "0 12px 24px -8px CATEGORY@20-25%",
    "buttonEdgeHeight": 5,
    "buttonPressTravel": 4,
    "hoverLift": { "translateY": -6, "rotateX": 2 },
    "pressScale": 0.97
  },
  "motion": {
    "durationMs": { "min": 150, "max": 250 },
    "easing": "ease-out",
    "staggerMs": 40,
    "reducedMotion": "respect prefers-reduced-motion / MediaQuery.disableAnimations"
  }
}
