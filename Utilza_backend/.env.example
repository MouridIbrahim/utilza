NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@localhost:5432/utilza?schema=public"

JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI provider (T116 gateway). Empty = AI calls fail closed with
# AI_NOT_CONFIGURED; never commit real values.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_TOKEN_LIMIT=100000

# Comma-separated emails allowed on /api/v1/admin/* (empty = admin disabled)
ADMIN_EMAILS=
