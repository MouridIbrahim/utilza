generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  favorites    Favorite[]
  history      ToolHistory[]
  subscription Subscription?

  @@index([email])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  tools       Tool[]
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // New-architecture classification (06-FULL-PROJECT-ARCHITECTURE.md §20):
  // "frontend" = React+Flutter own the logic; "backend" = Node.js executes it.
  implementation  String   @default("frontend")
  platforms       String[] @default(["web", "mobile"])
  requiresFile    Boolean  @default(false)
  requiresAuth    Boolean  @default(false)
  supportsOffline Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  favorites   Favorite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([slug])
  @@index([implementation, isActive])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
}

model ToolHistory {
  id           String   @id @default(cuid())
  userId       String
  toolSlug     String
  inputSummary String?  @db.VarChar(500)
  // New-architecture execution metadata (06 §17). Nullable so existing rows
  // stay valid; routes default them on write.
  executionType String?  @db.VarChar(16) // "frontend" | "backend"
  status        String   @default("completed") @db.VarChar(32)
  metadata      Json?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Metadata for files produced by backend tools (06 §13). The bytes live in
// object storage (or local temp); the DB holds only the pointer + lifecycle.
model GeneratedFile {
  id           String    @id @default(cuid())
  userId       String?
  toolId       String?
  toolSlug     String?   @db.VarChar(100)
  storageKey   String    @unique @db.VarChar(512)
  originalName String?   @db.VarChar(255)
  mimeType     String?   @db.VarChar(128)
  size         Int
  status       String    @default("ready") @db.VarChar(32) // ready|expired|deleted
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([toolSlug])
}

// Async job ledger for long-running work (T115, 06 §32: media, OCR, batch).
// Processors register in the worker dispatch table; the DB row is the
// source of truth clients poll. No processors ship yet (needs FFmpeg).
model Job {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(64)
  status    String   @default("queued") @db.VarChar(16) // queued|running|done|failed
  userId    String?
  input     Json?
  output    Json?
  error     String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

// Monthly AI usage metering per user (T116). Enforced by the AI gateway
// before any provider call; anonymous callers share one bucket.
model AiUsage {
  id     String @id @default(cuid())
  userId String @db.VarChar(64)
  month  String @db.VarChar(7) // YYYY-MM
  calls  Int    @default(0)
  tokens Int    @default(0)

  @@unique([userId, month])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("free")
  tier      String   @default("free")
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
